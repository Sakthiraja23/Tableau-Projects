      <aliases enabled='yes' />
      <column datatype='string' name='[Body Style]' role='dimension' type='nominal' />
      <column caption='YTD Total Sales' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[Calculation_1562749131448987648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF  &#13;&#10;YEAR([Date]) = {MAX(year([Date]))}&#13;&#10;THEN&#13;&#10;[Price ($)]&#13;&#10;END)' />
      </column>
      <column caption='YoY Sales  Growth' datatype='real' default-format='p0.00%' name='[Calculation_1562749131450753026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1562749131448987648]-[YTD Total Sales (copy)_1562749131450494977]) / [YTD Total Sales (copy)_1562749131450494977]' />
      </column>
      <column caption='YTD Cars Sold' datatype='integer' default-format='n&quot;#&quot;#,##0,.00K;-&quot;#&quot;#,##0,.00K' name='[Calculation_1562749131453194243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT( &#13;&#10;IF &#13;&#10;YEAR([Date]) = {MAX(YEAR([Date]))}&#13;&#10;THEN&#13;&#10;[Car_id]&#13;&#10;END)' />
      </column>
      <column caption='YoY Cars Sold Growth' datatype='real' default-format='p0.00%' name='[Calculation_1562749131453779973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1562749131453194243]-[YTD Cars Sold (copy)_1562749131453591556]) / [YTD Cars Sold (copy)_1562749131453591556]' />
      </column>
      <column caption='YTD Avg Price' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_1562749131455963142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1562749131448987648] / [Calculation_1562749131453194243]' />
      </column>
      <column caption='YoY Avg Growth' datatype='real' default-format='p0.00%' name='[Calculation_1562749131456458760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1562749131455963142] - [YTD Avg Price (copy)_1562749131456122887] ) / [YTD Avg Price (copy)_1562749131456122887]' />
      </column>
      <column caption='Car id' datatype='string' name='[Car_id]' role='dimension' type='nominal' />
      <column datatype='string' name='[Color]' role='dimension' type='nominal' />
      <column caption='Dealer Name' datatype='string' name='[Dealer_Name]' role='dimension' type='nominal' />
      <column caption='Dealer No' datatype='string' name='[Dealer_No]' role='dimension' type='nominal' />
      <column caption='Dealer Region' datatype='string' name='[Dealer_Region]' role='dimension' type='nominal' />
      <column datatype='string' name='[Transmission]' role='dimension' type='nominal' />
      <column caption='PYTD Avg Price ' datatype='real' name='[YTD Avg Price (copy)_1562749131456122887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[YTD Total Sales (copy)_1562749131450494977] / [YTD Cars Sold (copy)_1562749131453591556]' />
      </column>
      <column caption='PYTD Cars Sold ' datatype='integer' name='[YTD Cars Sold (copy)_1562749131453591556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT( &#13;&#10;IF &#13;&#10;YEAR([Date]) = {MAX(YEAR([Date]))} - 1&#13;&#10;THEN&#13;&#10;[Car_id]&#13;&#10;END)' />
      </column>
      <column caption='PYTD Total Sales ' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[YTD Total Sales (copy)_1562749131450494977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF  &#13;&#10;YEAR([Date]) = {MAX(year([Date]))} - 1&#13;&#10;THEN&#13;&#10;[Price ($)]&#13;&#10;END)' />
      </column>
