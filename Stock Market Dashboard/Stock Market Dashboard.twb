      <column aggregation='Sum' caption='Study Period' datatype='integer' name='[Calculation_344243957418631169]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Date] &gt;= [Parameters].[Parameter 1] AND  [Date] &lt;= [Parameters].[Parameter 2] THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Last Date Only' datatype='integer' name='[Calculation_344243957424644098]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF  [Date] = {MAX([Parameters].[Parameter 2])} THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Upper Price' datatype='string' name='[Calculation_344243957426900995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Percent change in price] &gt; 0 THEN &apos;↑&apos; END' />
      </column>
      <column caption='Lower Price' datatype='string' name='[Calculation_344243957427531780]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Percent change in price] &lt; 0 THEN &apos;↓&apos; END' />
      </column>
